# Application
NEXT_PUBLIC_APP_URL=
AUTH_SECRET=

# Google OAuth (Auth.js callback: /api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Serverless Postgres (use a pooled Neon connection string)
DATABASE_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional India GST rate in basis points (1800 = 18%). Defaults to 0.
GST_RATE_BPS=0

# Optional AI enhancement; deterministic discovery works without it
OPENAI_API_KEY=
OPENAI_MODEL=
