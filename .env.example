# Giggle Gallery environment variable names only. Never commit real credentials.

# Development (.env.local)
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
IDENTITY_HASH_PEPPER=
GST_RATE_BPS=0

# Preview (configure in Vercel Preview; use isolated database and provider test mode)
